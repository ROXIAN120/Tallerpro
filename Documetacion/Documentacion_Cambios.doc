    body { font-family: 'Calibri', sans-serif; line-height: 1.6; }
    h1 { color: #2c3e50; }
    h2 { color: #34495e; border-bottom: 1px solid #ccc; padding-bottom: 5px; }
    h3 { color: #e67e22; }
    ul { margin-bottom: 20px; }
    .code { background-color: #f4f4f4; padding: 10px; border-radius: 5px; font-family: 'Courier New', monospace; font-size: 14px;}
    .important { font-weight: bold; color: #c0392b; }
</style>
